rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permitir leitura e escrita para sincronização de dados entre computador e celular
    match /products/{productId} {
      allow read, write: if true;
    }

    match /clients/{clientId} {
      allow read, write: if true;
    }

    match /suppliers/{supplierId} {
      allow read, write: if true;
    }

    match /serviceOrders/{orderId} {
      allow read, write: if true;
    }

    match /directSales/{saleId} {
      allow read, write: if true;
    }

    match /cashSessions/{sessionId} {
      allow read, write: if true;
    }

    match /cashMovements/{movementId} {
      allow read, write: if true;
    }

    match /appointments/{appointmentId} {
      allow read, write: if true;
    }

    match /paymentReceipts/{receiptId} {
      allow read, write: if true;
    }

    match /systemSync/{syncId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
