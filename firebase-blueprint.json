{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Produto ou peça do catálogo de estoque",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "costPrice": { "type": "number" },
        "retailPrice": { "type": "number" },
        "wholesalePrice": { "type": "number" },
        "currentStock": { "type": "number" },
        "minStock": { "type": "number" },
        "unit": { "type": "string" },
        "ncm": { "type": "string" }
      },
      "required": ["id", "code", "name", "category", "currentStock"]
    },
    "Client": {
      "title": "Client",
      "description": "Cadastro de cliente da empresa",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "customerType": { "type": "string", "enum": ["varejo", "atacado"] },
        "phone": { "type": "string" },
        "email": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "ServiceOrder": {
      "title": "ServiceOrder",
      "description": "Ordem de serviço operacional",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "clientId": { "type": "string" },
        "status": { "type": "string" },
        "paymentStatus": { "type": "string" }
      },
      "required": ["id", "code", "clientId", "status"]
    },
    "DirectSale": {
      "title": "DirectSale",
      "description": "Venda direta ou venda de balcão PDV",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "clientName": { "type": "string" },
        "total": { "type": "number" },
        "paymentStatus": { "type": "string" }
      },
      "required": ["id", "code", "total", "paymentStatus"]
    },
    "CashRegisterSession": {
      "title": "CashRegisterSession",
      "description": "Sessão de abertura e fechamento de caixa do PDV",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "terminalName": { "type": "string" },
        "operatorName": { "type": "string" },
        "openingBalance": { "type": "number" },
        "status": { "type": "string" },
        "openedAt": { "type": "string" }
      },
      "required": ["id", "code", "terminalName", "status", "openedAt"]
    },
    "CashRegisterMovement": {
      "title": "CashRegisterMovement",
      "description": "Movimentação financeira de recebimento, suprimento ou sangria no caixa do PDV",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sessionId": { "type": "string" },
        "type": { "type": "string" },
        "description": { "type": "string" },
        "grossAmount": { "type": "number" },
        "netAmount": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "sessionId", "type", "grossAmount", "createdAt"]
    },
    "SystemSync": {
      "title": "SystemSync",
      "description": "Sincronização de dados corporativos entre computador e celular",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      },
      "required": ["id", "updatedAt"]
    },
    "PaymentReceipt": {
      "title": "PaymentReceipt",
      "description": "Recibo de pagamento gerado automaticamente no PDV, Vendas ou Ordens de Serviço",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "receiptNumber": { "type": "string" },
        "sourceType": { "type": "string", "enum": ["os", "venda"] },
        "sourceId": { "type": "string" },
        "sourceCode": { "type": "string" },
        "clientName": { "type": "string" },
        "orderTotal": { "type": "number" },
        "amountPaidNow": { "type": "number" },
        "remainingBalance": { "type": "number" },
        "isFullyPaid": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "receiptNumber", "sourceType", "sourceId", "sourceCode", "amountPaidNow", "isFullyPaid", "createdAt"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Produtos do catálogo sincronizados em tempo real"
    },
    "/clients/{clientId}": {
      "schema": "Client",
      "description": "Clientes da empresa sincronizados em tempo real"
    },
    "/serviceOrders/{orderId}": {
      "schema": "ServiceOrder",
      "description": "Ordens de serviço sincronizadas em tempo real"
    },
    "/directSales/{saleId}": {
      "schema": "DirectSale",
      "description": "Vendas diretas e de balcão sincronizadas em tempo real"
    },
    "/cashSessions/{sessionId}": {
      "schema": "CashRegisterSession",
      "description": "Sessões de caixa PDV sincronizadas em tempo real"
    },
    "/cashMovements/{movementId}": {
      "schema": "CashRegisterMovement",
      "description": "Movimentações de recebimento, suprimento e sangria do PDV sincronizadas em tempo real"
    },
    "/paymentReceipts/{receiptId}": {
      "schema": "PaymentReceipt",
      "description": "Recibos de pagamento emitidos no caixa sincronizados em tempo real"
    },
    "/systemSync/{syncId}": {
      "schema": "SystemSync",
      "description": "Armazenamento sincronizado central de dados e entidades"
    }
  }
}
